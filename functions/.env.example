# Template nama konfigurasi backend. Jangan isi nilai asli di file yang di-commit.
# Provider tanpa key akan tampil sebagai not_configured dan tidak dipanggil.

URLSCAN_API_KEY=
VIRUSTOTAL_API_KEY=
# OpenPhish: endpoint check publik tidak memerlukan kunci; opsional bila memakai layanan berbayar.
OPENPHISH_API_KEY=
THREATFOX_API_KEY=
# Cloudflare Radar URL Scanner: token API dan ID account Cloudflare.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
OTX_API_KEY=
# Hybrid Analysis (CrowdStrike Falcon Sandbox) = Agen 7. Penelusuran reputasi read-only atas
# laporan yang sudah ada (POST /api/v2/search/terms, header `api-key`). Tanpa kunci, agen tampil
# sebagai not_configured dan tidak mengirim apa pun ke provider. Agen ini tidak pernah mengirim
# URL untuk analisis sandbox. Isi kunci yang DIROTASI di backend; jangan pakai kunci yang pernah
# terlihat di chat/log.
HYBRID_ANALYSIS_API_KEY=
# Google Safe Browsing v5 `urls.search`: kunci API Google Cloud (dibuat di Google Cloud Console,
# proyek dengan "Safe Browsing API" diaktifkan). Kunci dipakai backend sebagai query parameter
# pada GET /v5/urls:search?key=...&urls=<URL> dan TIDAK PERNAH dikirim ke frontend/log. Tanpa
# kunci, agen tampil sebagai belum dikonfigurasi dan URL tidak dikirim ke Google. Lookup API v4
# (POST /v4/threatMatches:find) sudah deprecated oleh Google (banner 2026-03-10) dan tidak
# dipakai lagi.
GOOGLE_SAFE_BROWSING_API_KEY=

# ---- Kebijakan umur laporan & cache hasil pemeriksaan (backend only) ----
# Semua knob di bagian ini berupa ANGKA, bukan rahasia, dan boleh dibiarkan kosong: nilai
# kosong memakai default yang sudah aman. Nilai yang tidak valid (0, negatif, bukan angka,
# atau melebihi batas atas) diabaikan dan default dipakai, sehingga konfigurasi tidak dapat
# melonggarkan kebijakan secara tidak sengaja.
#
# Cache disimpan di memori proses backend, keyed pada hash SHA-256 (agen + URL ternormalisasi
# + kebijakan). URL mentah, nilai query, dan kunci API tidak pernah menjadi key, tidak pernah
# di-log, dan tidak pernah dikirim ke frontend.
#
# Umur maksimum laporan yang boleh dipakai ulang agen (jam; maks 168 untuk urlscan/radar,
# 720 untuk virustotal).
URLSCAN_MAX_REPORT_AGE_HOURS=
VIRUSTOTAL_MAX_REPORT_AGE_HOURS=
RADAR_MAX_REPORT_AGE_HOURS=

# SCAN_CACHE_ENABLED=false mematikan seluruh cache hasil agen.
# SCAN_CACHE_MAX_ENTRIES: jumlah entri maksimum dalam memori (default 200, maks 2000);
# entri kedaluwarsa dibuang lebih dulu, lalu yang paling lama tidak dipakai.
SCAN_CACHE_ENABLED=
SCAN_CACHE_MAX_ENTRIES=

# TTL jawaban tiap agen dalam MENIT (maks 720). Default: urlscan/virustotal/radar/otx/hybrid
# 60, openphish/threatfox 15, safebrowsing 30. Ini kebijakan VERIGUARD, bukan janji penyedia;
# setiap default jauh lebih ketat daripada umur laporan yang boleh dipakai ulang agennya.
# Untuk Google Safe Browsing, rekomendasi `cache_duration` dari Google ikut memotong TTL ini.
URLSCAN_RESULT_TTL_MINUTES=
VIRUSTOTAL_RESULT_TTL_MINUTES=
OPENPHISH_RESULT_TTL_MINUTES=
THREATFOX_RESULT_TTL_MINUTES=
RADAR_RESULT_TTL_MINUTES=
OTX_RESULT_TTL_MINUTES=
HYBRID_RESULT_TTL_MINUTES=
SAFEBROWSING_RESULT_TTL_MINUTES=

# Lama status kegagalan sementara (rate_limited/unavailable/timeout) ditahan dalam DETIK
# (default 30, maks 300). Status disimpan apa adanya dan tidak pernah berubah menjadi
# not_found. skipped/error/auth_failed/not_configured tidak pernah di-cache.
PROVIDER_FAILURE_TTL_SECONDS=

# Feed komunitas OpenPhish diperbarui hulu ±12 jam; satu snapshot dipakai untuk semua URL.
# OPENPHISH_FEED_TTL_MINUTES: umur snapshot yang masih dianggap segar (default 15, maks 720).
# OPENPHISH_FEED_STALE_TTL_MINUTES: jendela maksimum snapshot lama boleh dipakai HANYA ketika
# unduhan ulang gagal; hasilnya selalu ditandai basi di laporan (default 720, maks 4320).
OPENPHISH_FEED_TTL_MINUTES=
OPENPHISH_FEED_STALE_TTL_MINUTES=

# ---- Cloudflare Turnstile (verifikasi CAPTCHA adaptif, backend only) ----
# SECRET hanya dipakai server untuk memverifikasi token ke Cloudflare; nilai ini tidak pernah
# dikirim ke browser dan tidak pernah di-log. Kosong = gerbang CAPTCHA nonaktif; bila suatu saat
# diminta, layanan membalas `captcha_not_configured` tanpa menghubungi Cloudflare.
TURNSTILE_SECRET_KEY=
# Opsional: DAFTAR hostname widget yang diizinkan, terpisah koma (mis.
# veriguard-ai-ad35d.web.app,veriguard-ai-ad35d.firebaseapp.com). Kosong = hostname tidak
# dibandingkan; `action` (register/scan) tetap selalu dicocokkan di server.
TURNSTILE_HOSTNAMES=
# P1-2: ID proyek Firebase untuk memverifikasi ID token (nilai publik, bukan rahasia).
FIREBASE_PROJECT_ID=
