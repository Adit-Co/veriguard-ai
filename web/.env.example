# Mode analisis: local (engine di browser). Mode firebase disiapkan untuk
# integrasi Cloud Functions + Gemini, tetapi belum diaktifkan di UI.
VITE_ANALYSIS_MODE=local

# Konfigurasi Firebase Web SDK. Nilai web config bersifat publik, bukan secret.
# Tanpa empat nilai wajib ini, aplikasi memakai sesi demo lokal.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Opsional. Jika diisi, Web SDK menginisialisasi App Check dengan reCAPTCHA v3.
# Enforcement di Cloud Functions tetap harus diaktifkan manual setelah site key terdaftar.
VITE_RECAPTCHA_SITE_KEY=

# Opsi persetujuan pemeriksaan eksternal aktif secara default.
# Set false untuk menyembunyikan/menonaktifkan opsi ini pada build tertentu.
# Jangan menaruh key provider di variabel VITE_*.
VITE_MULTI_SOURCE_ENABLED=true

# URL backend pemeriksaan. Prioritas runtime: VITE_API_BASE_URL > VITE_SCANNER_WORKER_URL.
# Nilai ini bukan secret. Jangan menaruh key provider di variabel VITE_*.
#
# Pisahkan endpoint per mode agar host lokal tidak pernah masuk build produksi:
# - .env.development.local : VITE_API_BASE_URL=http://127.0.0.1:8787 (backend Node lokal)
# - .env.production.local  : VITE_SCANNER_WORKER_URL=https://... (HTTPS, non-lokal)
#
# Build produksi dihentikan oleh vite.config.ts bila kedua variabel kosong, bila endpoint
# memakai HTTP, atau bila mengarah ke localhost/loopback. Tidak ada endpoint pengganti
# yang dibuat otomatis. Build uji UI memakai `vite build --mode verify` dan tidak tunduk
# pada pemeriksaan produksi.
VITE_API_BASE_URL=

# (fallback) URL Cloudflare Worker scanner. Kosongkan jika memakai VITE_API_BASE_URL.
VITE_SCANNER_WORKER_URL=

# Cloudflare Turnstile (site key mode Managed). Kunci situs boleh publik; SECRET_KEY-nya
# hanya ada di backend. Kunci ini wajib untuk pendaftaran: bila kosong, formulir registrasi
# berhenti dengan pesan konfigurasi dan tidak ada akun yang dibuat. Pemeriksaan URL hanya
# meminta CAPTCHA saat pemakai melewati ambang batas adaptif.
VITE_TURNSTILE_SITE_KEY=

# Emulator Firebase hanya untuk mode development. Aplikasi mengabaikan nilai ini pada
# build produksi, dan konfigurasi URL wajib diisi eksplisit (tidak ada default lokal
# yang tertanam di kode).
VITE_USE_EMULATORS=false
VITE_AUTH_EMULATOR_URL=
VITE_FIRESTORE_EMULATOR_HOST=
VITE_FUNCTIONS_EMULATOR_HOST=
VITE_FUNCTIONS_REGION=asia-southeast2

# Akun Demo di halaman /masuk. Default NONAKTIF — isi `true` hanya di .env.development.local.
# Tiga syarat teknis ikut diperlukan: dev server (`vite`, bukan `vite build`), mode development,
# dan emulator Firebase pada host loopback (VITE_USE_EMULATORS=true + VITE_AUTH_EMULATOR_URL
# http://127.0.0.1:9099). Peran admin tidak dibuat di peramban: dev server mencetak token custom
# KHAS EMULATOR dan menulis klaim serta dokumen `admins/{uid}` lewat jalur istimewa emulator lokal.
# `config/productionEnv.ts` menggagalkan build produksi bila bendera ini ikut ter-set.
VITE_ENABLE_DEMO_LOGIN=false

# Jalur Community Reports. Build produksi hanya mendukung `firestore`, yaitu Firebase
# Spark (Auth + Firestore + Security Rules) tanpa Cloud Functions maupun billing.
# Nilai lain akan menggagalkan build produksi; implementasi Cloud Functions lama tidak
# diaktifkan kembali.
VITE_COMMUNITY_BACKEND=firestore

# Jangan menaruh GEMINI_API_KEY, service account, atau secret lain di file VITE_*.
# Secret Gemini hanya disimpan melalui Firebase Functions secrets.
