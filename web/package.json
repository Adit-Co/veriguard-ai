{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:emulators": "node scripts/dev-emulators.mjs",
    "build": "node ../scripts/check-release-integrity.mjs --pre-build && tsc -b && vite build && node scripts/inspect-bundle.mjs",
    "typecheck": "tsc -b",
    "inspect:bundle": "node scripts/inspect-bundle.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/e2e.mjs",
    "verify:ui": "node scripts/verify-ui.mjs",
    "verify:csp": "node scripts/verify-csp.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^12.19.0",
    "lucide-react": "^1.60.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "jsdom": "^29.1.1",
    "oxlint": "^1.88.0",
    "playwright": "^1.64.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@firebase/app": "0.16.2",
    "@firebase/app-compat": "0.5.18",
    "@grpc/grpc-js": "1.14.6"
  }
}
