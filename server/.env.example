# Server lokal VERIGUARD - salin ke .env lalu isi nilainya.
# File .env tidak di-commit (sudah di-.gitignore).

# Port server backend lokal
SERVER_PORT=8787

# Host binding (biarkan 127.0.0.1 agar tidak terekspos ke jaringan sekitar)
SERVER_HOST=127.0.0.1

# Origin frontend yang diizinkan (dipisah koma)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Rate limit per alamat IP
RATE_LIMIT_MAX_PER_IP=30
RATE_LIMIT_WINDOW_SECONDS=60

# Jumlah provider maksimum yang berjalan bersamaan (1-8)
PROVIDER_CONCURRENCY=4

# Provider yang aktif saat ini - isi dari kredensial Anda masing-masing:
URLSCAN_API_KEY=
VIRUSTOTAL_API_KEY=
THREATFOX_API_KEY=
OTX_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=
HYBRID_ANALYSIS_API_KEY=

# Cloudflare Radar URL Scanner (butuh token API dan ID account).
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# OpenPhish berjalan tanpa kunci (endpoint check publik); isi bila ingin memakai kunci berbayar.
OPENPHISH_API_KEY=

# Cloudflare Turnstile (verifikasi CAPTCHA adaptif). SECRET hanya di backend — tidak pernah
# dikirim ke browser. Isian kosong berarti gerbang CAPTCHA nonaktif dan layanan membalas
# `captcha_not_configured` bila suatu saat diminta, tanpa memanggil Cloudflare.
TURNSTILE_SECRET_KEY=
# Opsional: daftar hostname widget yang diizinkan, terpisah koma. Kosong = pemeriksaan
# hostname dilewati.
TURNSTILE_HOSTNAMES=
# P1-2: ID proyek Firebase untuk memverifikasi ID token dari browser yang sudah masuk.
# Kosong = backend lokal memperlakukan semua permintaan sebagai tamu (tanpa 401).
FIREBASE_PROJECT_ID=
# VGL-40: host Auth Emulator lokal yang dipakai backend ini, contoh `127.0.0.1:9099`.
# Auth Emulator menandatangani ID token tanpa tanda tangan (alg `none`), sehingga tanpa nilai
# ini sesi lokal selalu ditolak dan scanner jatuh ke pesan "Sesi tidak dikenali". Token tanpa
# tanda tangan HANYA diterima bila host ini loopback, dan tetap dikonfirmasi ulang ke emulator
# lewat accounts:lookup. Kosong = hanya token RS256 produksi yang sah.
# JANGAN pernah diisi pada deployment production.
FIREBASE_AUTH_EMULATOR_HOST=
