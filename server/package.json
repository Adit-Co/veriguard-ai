{
  "name": "veriguard-local-server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node ../scripts/check-release-integrity.mjs --pre-build && tsc",
    "dev": "npm run build && node dist/server/src/index.js",
    "start": "node dist/server/src/index.js",
    "live-check": "node dist/server/src/live-check.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
